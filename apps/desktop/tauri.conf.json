{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "DJMesrc",
    "version":  "0.5.4",
    "identifier":  "com.djmesrc.desktop",
    "build":  {
                  "beforeDevCommand":  "corepack pnpm --filter @djmesrc/ui dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "corepack pnpm --filter @djmesrc/ui build",
                  "frontendDist":  "../../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "DJMesrc | Event Audio",
                                    "maximized":  true,
                                    "width":  1440,
                                    "height":  920,
                                    "minWidth":  1024,
                                    "minHeight":  720
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installerIcon":  "icons/icon.ico",
                                                "uninstallerIcon":  "icons/icon.ico"
                                            }
                               }
               }
}
