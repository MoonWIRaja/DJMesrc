    "version":  "0.5.4",
    "packageManager":  "pnpm@12.14.0",
    "scripts":  {
                    "dev":  "corepack pnpm --filter @djmesrc/desktop dev",
                    "build":  "corepack pnpm --filter @djmesrc/ui build",
